VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
# SIE: enable with REAL_SIE=1 and FAKE=0; warm with uv run python scripts/sie_warm.py --keep
SIE_API_KEY=
COGNEE_API_KEY=
COGNEE_URL=
COGNEE_TENANT_ID=
COGNEE_DATASET=family
SINGLESTORE_URL=
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
# Resend bearer key for email questions.
RESEND_API_KEY=
AMPLITUDE_API_KEY=
REAL_AMPLITUDE=0
# Set 1 to also send the redacted conversation text to Amplitude; default off sends only placeholders.
AMPLITUDE_SEND_TEXT=0
STATSIG_SERVER_SECRET=
# Public HTTPS server address used by email answer links.
PUBLIC_BASE_URL=
TRANSFER_TO_NUMBER=
APP_SECRET=
FAKE=
REAL_VAPI=
REAL_TELEGRAM=
REAL_DB=
REAL_SIE=0
REAL_COGNEE=
REAL_PERSONA=
VAPI_SERVER_SECRET=
TELEGRAM_WEBHOOK_SECRET=
OWNER_CHAT_ID=
TIMEOUT_S=
OWNER_NAME=Mum
SENSO_API_KEY=
REAL_SENSO=0

# Enable WhatsApp questions through the local Beeper Desktop API.
REAL_BEEPER=0
# Beeper Desktop API bearer access token.
BEEPER_ACCESS_TOKEN=
# WhatsApp chat receiving the question.
BEEPER_CHAT_ID=
# Optional API address; defaults to http://localhost:23373.
BEEPER_BASE_URL=
# Enable Resend email questions.
REAL_EMAIL=0
# Recipient of email questions.
PING_EMAIL_TO=
# Optional sender; defaults to Call Guard <onboarding@resend.dev>.
PING_EMAIL_FROM=

# 1 = also call the engine to redact final transcript lines (blocks up to 400 ms per line)
REDACT_SIE=0
# Scam-script match (Superlinked embeddings + SingleStore vector search): REAL_MATCH=1 with REAL_DB=1 REAL_SIE=1 FAKE=0; load once with scripts/scam_scripts_load.py
REAL_MATCH=

# Google OAuth web client id for "Continue with Google" on /app.
GOOGLE_CLIENT_ID=
# 1 = offer the demo sign-in even when a Google client id is set.
DEMO_LOGIN=
# The guard's own number that calls are forwarded to; shown on /app.
GUARD_NUMBER=
# Optional Persona environment id (env_...) to select the sandbox for the hosted check.
PERSONA_ENVIRONMENT_ID=
# Optional ready-made link to an inquiry prepared in Persona's dashboard; used instead of the template link.
PERSONA_INQUIRY_URL=
# Optional published template version (itmplv_...); used instead of the template id.
PERSONA_TEMPLATE_VERSION_ID=

# 1 = scan the real Gmail inbox (needs GMAIL_ACCESS_TOKEN and FAKE=0); 0 = use the sample mailbox in data/gmail_sample.json.
REAL_GMAIL=0
# OAuth access token with the gmail.readonly scope; used only when REAL_GMAIL=1.
GMAIL_ACCESS_TOKEN=
